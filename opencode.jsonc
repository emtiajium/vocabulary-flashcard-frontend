{
    "$schema": "https://opencode.ai/config.json",
    "enabled_providers": ["openrouter"],
    "model": "openrouter/deepseek/deepseek-v4.1-flash",
    "small_model": "openrouter/google/gemini-3.1-flash-lite",
    "provider": {
        "openrouter": {
            "options": {
                "apiKey": "{env:OPENROUTER_API_KEY_PERSONAL}"
            },
            "models": {
                "deepseek/deepseek-v4.1-flash": {
                    "name": "DeepSeek V4.1 Flash"
                },
                "deepseek/deepseek-v4-flash-0731": {
                    "name": "DeepSeek V4 Flash 0731"
                },
                "google/gemini-3.1-flash-lite": {
                    "name": "Gemini 3.1 Flash Lite"
                }
            }
        }
    },
    "mcp": {
        "Lottiefiles": {
            "type": "remote",
            "url": "https://mcp.lottiefiles.com/mcp",
            "oauth": {},
            "enabled": false
        }
    },
    "permission": {
        "*": "ask",
        "read": {
            "*": "allow",
            "*.env": "deny",
            "*.env.*": "deny",
            "*.env.sample": "allow",
            "*.env.test": "allow",
            "*.pem": "deny",
            "*.key": "deny",
            "**/.npmrc": "deny",
            "**/.bashrc": "deny",
            "**/.zshrc": "deny",
            "**/.envrc": "deny",
            "**/auth.json": "deny",
            "*.npmrc": "deny"
        },
        "glob": "allow",
        "grep": "ask",
        "edit": "ask",
        "bash": {
            "*": "ask",
            "pwd": "allow",
            "ls": "allow",
            "ls -la": "allow",
            "ls -l": "allow",
            "cd": "allow",
            "cd *": "allow",
            "git status": "allow",
            "git status --short": "allow",
            "git status --porcelain": "allow",
            "git diff": "allow",
            "git diff --stat": "allow",
            "git diff --cached": "allow",
            "git log": "allow",
            "git log --oneline -5": "allow",
            "rg --files": "allow",
            "rg --files src": "allow",
            "rg --files docs": "allow",
            "git push": "deny",
            "git push *": "deny",
            "rm": "deny",
            "rm *": "deny",
            "unlink": "deny",
            "unlink *": "deny",
            "sudo": "deny",
            "sudo *": "deny"
        },
        "webfetch": "deny",
        "external_directory": "ask"
    },
    "instructions": [],
    "compaction": {
        "auto": true,
        "prune": true
    },
    "agent": {
        "plan": {
            "steps": 8
        },
        "build": {
            "steps": 20
        }
    }
}
