{
    "$schema": "https://opencode.ai/config.json",
    "enabled_providers": ["openrouter"],
    "model": "openrouter/deepseek/deepseek-v4.1-flash",
    "small_model": "openrouter/google/gemini-3.1-flash-lite",
    "provider": {
        "openrouter": {
            "options": {
                "apiKey": "{env:OPENROUTER_API_KEY}"
            },
            "models": {
                "deepseek/deepseek-v4.1-flash": {
                    "name": "DeepSeek V4.1 Flash"
                },
                "google/gemini-3.1-flash-lite": {
                    "name": "Gemini 3.1 Flash Lite"
                }
            }
        }
    },
    "mcp": {
        "Lottiefiles": {
            "type": "remote",
            "url": "https://mcp.lottiefiles.com/mcp",
            "oauth": {}
        }
    },
    "permission": {
        "*": "ask",
        "read": {
            "*": "allow",
            "*.env": "deny",
            "*.env.*": "deny",
            "*.env.sample": "allow",
            "*.env.test": "allow",
            "**/.bashrc": "deny"
        },
        "edit": "ask",
        "bash": {
            "*": "ask",
            "cat": "allow",
            "cat *": "allow",
            "nano": "allow",
            "node": "allow",
            "node *": "allow",
            "npx": "allow",
            "npx *": "allow",
            "npm run *": "allow",
            "unlink": "allow",
            "pwd": "allow",
            "ls": "allow",
            "ls *": "allow",
            "cd": "allow",
            "cd *": "allow",
            "grep": "allow",
            "grep *": "allow",
            "rg": "allow",
            "rg *": "allow",
            "chmode": "allow",
            "head": "allow",
            "head *": "allow",
            "tail": "allow",
            "tail *": "allow",
            "sed": "allow",
            "sed *": "allow",
            "echo": "allow",
            "echo *": "allow",
            "git status*": "allow",
            "git diff*": "allow",
            "git log*": "allow",
            "git push*": "deny",
            "git commit*": "ask",
            "rm *": "deny"
        },
        "webfetch": "deny",
        "external_directory": "ask"
    }
}
