{
    "name": "vocabulary-flashcard-frontend",
    "version": "8.0.1",
    "private": true,
    "description": "Build your own dictionary, create flashcards, memorize vocabularies",
    "scripts": {
        "create:capacitor.config": "node -r fs -e \"fs.copyFileSync('capacitor.config.json.text', 'capacitor.config.json', fs.constants.COPYFILE_EXCL)\" && prettier --write \"capacitor.config.json\"",
        "create:config": "node -r fs -e \"fs.copyFileSync('config.json.text', 'config.json', fs.constants.COPYFILE_EXCL)\" && prettier --write \"config.json\"",
        "serve": "vue-cli-service serve --port 8090",
        "build": "vue-cli-service build",
        "lint": "vue-cli-service lint --fix",
        "lint:check": "vue-cli-service lint --no-fix",
        "format": "prettier --write \"{public,scripts,src,tests}/**/*.{cjs,json,html,css,ts,vue,md}\" \"*.{md,js,json,jsonc}\" \"**/**/*.yml\"",
        "format:check": "prettier --check \"{public,scripts,src,tests}/**/*.{cjs,json,html,css,ts,vue,md}\" \"*.{md,js,json,jsonc}\" \"**/**/*.yml\"",
        "test": "jest",
        "typecheck": "vue-tsc --noEmit",
        "ci": "npm run format:check && npm run lint:check && npm run typecheck && npm run test && npm run build",
        "serve:android:anew": "rm -rf android/ && ionic build --prod --release && npx cap add android && npx cap sync android",
        "serve:android:anew:prod": "node cloud-server.js && node server-validator-before-release.js && npm run serve:android:anew && node local-server.js",
        "deploy:firebase": "node cloud-server.js && node server-validator-before-release.js && npm run build && firebase deploy --only hosting && node local-server.js",
        "replace-generated-android-files": "bash ./replace-generated-android-files.sh",
        "android-pre-bundle": "npm run serve:android:anew:prod && npm run replace-generated-android-files",
        "android-pre-bundle:local": "npm run serve:android:anew && npm run replace-generated-android-files",
        "store:serve": "VUE_APP_STORE_SCREENSHOTS=true vue-cli-service serve --port 8090",
        "store:capture": "node scripts/play-store/capture.cjs",
        "store:render": "node scripts/play-store/render.cjs",
        "store:images": "npm run store:capture && npm run store:render",
        "lottie:preview": "node scripts/lottie-preview.cjs"
    },
    "dependencies": {
        "@capacitor/android": "^8.0.1",
        "@capacitor/app": "^8.0.0",
        "@capacitor/core": "^8.0.1",
        "@capacitor/device": "^8.0.0",
        "@capacitor/status-bar": "^8.0.0",
        "@capawesome/capacitor-android-edge-to-edge-support": "^8.0.2",
        "@capgo/capacitor-social-login": "^8.2.14",
        "@fortawesome/fontawesome-svg-core": "^6.1.1",
        "@fortawesome/free-brands-svg-icons": "^6.1.1",
        "@fortawesome/free-regular-svg-icons": "^6.1.1",
        "@fortawesome/free-solid-svg-icons": "^6.1.1",
        "@fortawesome/vue-fontawesome": "^3.0.0-5",
        "@ionic-native/core": "^5.34.0",
        "@ionic-native/theme-detection": "^5.34.0",
        "@ionic/core": "^8.7.17",
        "@ionic/storage": "^3.0.4",
        "@ionic/vue": "^8.0.0",
        "@ionic/vue-router": "^8.0.0",
        "axios": "1.20.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "cordova-plugin-theme-detection": "^1.3.0",
        "core-js": "^3.6.5",
        "date-fns": "^3.6.0",
        "google-auth-library": "^8.7.0",
        "lodash": "^4.17.23",
        "lottie-web": "^5.13.0",
        "reflect-metadata": "^0.1.13",
        "swiper": "^12.1.2",
        "uuid": "^8.3.2",
        "vue": "^3.3.0",
        "vue-router": "^4.2.0"
    },
    "devDependencies": {
        "@capacitor/cli": "^8.0.1",
        "@ionic/cli": "^6.16.3",
        "@types/google.accounts": "^0.0.18",
        "@types/jest": "^29.5.14",
        "@types/lodash": "^4.14.170",
        "@types/uuid": "^8.3.0",
        "@typescript-eslint/eslint-plugin": "^5.4.0",
        "@typescript-eslint/parser": "^5.4.0",
        "@vue/cli": "^5.0.8",
        "@vue/cli-plugin-babel": "^5.0.8",
        "@vue/cli-plugin-eslint": "^5.0.8",
        "@vue/cli-plugin-router": "^5.0.8",
        "@vue/cli-plugin-typescript": "^5.0.8",
        "@vue/cli-service": "^5.0.8",
        "@vue/compiler-sfc": "^3.3.4",
        "@vue/eslint-config-airbnb": "^6.0.0",
        "@vue/eslint-config-typescript": "^12.0.0",
        "@vue/test-utils": "^2.5.1",
        "@vue/vue3-jest": "^29.2.6",
        "babel-jest": "^29.7.0",
        "eslint": "^8.35.0",
        "eslint-config-prettier": "^8.3.0",
        "eslint-plugin-import": "^2.25.3",
        "eslint-plugin-prettier": "^3.4.0",
        "eslint-plugin-vue": "^9.9.0",
        "eslint-plugin-vuejs-accessibility": "^1.1.0",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "node-polyfill-webpack-plugin": "^2.0.1",
        "playwright": "^1.64.1",
        "prettier": "^2.3.1",
        "sharp": "^0.35.5",
        "ts-jest": "^29.4.15",
        "typescript": "~5.9.0",
        "vue-tsc": "^2.1.10"
    },
    "jest": {
        "testEnvironment": "node",
        "testEnvironmentOptions": {
            "customExportConditions": [
                "node"
            ]
        },
        "roots": [
            "<rootDir>/tests"
        ],
        "testMatch": [
            "<rootDir>/tests/**/*.spec.ts"
        ],
        "moduleFileExtensions": [
            "ts",
            "js",
            "json",
            "vue"
        ],
        "transform": {
            "^.+\\.vue$": "@vue/vue3-jest",
            "^.+\\.ts$": [
                "ts-jest",
                {
                    "tsconfig": "<rootDir>/tests/tsconfig.json"
                }
            ]
        },
        "moduleNameMapper": {
            "^@/(.*)$": "<rootDir>/src/$1"
        },
        "setupFiles": [
            "<rootDir>/tests/jest-init.ts"
        ],
        "clearMocks": true
    }
}
